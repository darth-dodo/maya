{
  "permissions": {
    "allow": [
      "Bash(mix deps.get *)",
      "Bash(mix compile *)",
      "Bash(mix format *)",
      "Bash(mix credo *)",
      "Bash(mix test *)",
      "Bash(mix precommit *)",
      "Bash(mix ecto.create *)",
      "Bash(mix ecto.migrate *)",
      "Bash(mix ecto.gen.migration *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Read(./.env)"
    ]
  }
}
