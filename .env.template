# Copy to .env and fill in. .env is git and Docker ignored; never commit it.
#   cp .env.template .env
# Phoenix does not read .env by itself. Load it into your shell first:
#   set -a; source .env; set +a; mix phx.server
# Production values live in the Render dashboard (render.yaml lists them), not here.

# --- App: production only (dev and test use config/dev.exs and config/test.exs) ---

# Supabase SESSION POOLER URI, from Supabase > Connect > Session pooler. Check all three:
#   user postgres.<project-ref>, host aws-0-eu-west-1.pooler.supabase.com, port 5432.
# Not the https://<ref>.supabase.co API URL, not the IPv6-only db.<ref>.supabase.co direct host,
# not port 6543 (transaction mode breaks Ecto prepared statements). URL-encode password special characters.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# mix phx.gen.secret (64+ bytes)
SECRET_KEY_BASE=
# Keep low for the Supabase free pooler
POOL_SIZE=5
# Public host for URLs and the LiveView origin check. Render sets RENDER_EXTERNAL_HOSTNAME, so leave empty there.
PHX_HOST=
PORT=4000
# Set to true to start the web server in a release (bin/server sets it for you)
PHX_SERVER=

# --- Maya runtime: needed from the agent and voice blocks ---

OPENROUTER_API_KEY=
MISTRAL_API_KEY=
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- Factory: Telegram watcher (F4) ---

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
