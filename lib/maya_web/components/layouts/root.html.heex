<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Maya" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta
      name="description"
      content="Maps, Answers, Yaps, Advice. A spoiler-free Pokémon Emerald companion."
    />
    <%!-- Robots per page: only pages that set :indexable (the home and factory pages) may be indexed. --%>
    <meta :if={!assigns[:indexable]} name="robots" content="noindex, nofollow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0f5a3a" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08181a" />
    <%!-- Root files keep plain paths: phx.digest names them manifest-<hash>.webmanifest,
         which Plug.Static's `only:` list (exact first segment) would not serve. --%>
    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
    <link rel="icon" href={~p"/images/favicon-32.png"} sizes="32x32" type="image/png" />
    <link rel="icon" href={~p"/images/favicon-16.png"} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Maya" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maya" />
    <meta property="og:title" content="Maya" />
    <meta
      property="og:description"
      content="Maps, Answers, Yaps, Advice. A spoiler-free Pokémon Emerald companion."
    />
    <meta property="og:url" content={url(~p"/")} />
    <meta property="og:image" content={url(~p"/images/og-image.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Maya: an Emerald green ball floating above soft tide waves at sunrise."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Maya" />
    <meta
      name="twitter:description"
      content="Maps, Answers, Yaps, Advice. A spoiler-free Pokémon Emerald companion."
    />
    <meta name="twitter:image" content={url(~p"/images/og-image.png")} />
    <%!-- Inter is the body font on every page, so it is the one preload (Fraunces swaps in). --%>
    <link
      rel="preload"
      href={~p"/fonts/inter-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const root = document.documentElement;
        const dark = matchMedia("(prefers-color-scheme: dark)");
        // Storage can throw (blocked, private modes): a tap on this page is kept in memory too.
        let tapped = null;
        const read = () => {
          if (tapped) return tapped;
          try {
            return localStorage.getItem("phx:theme");
          } catch {
            return null;
          }
        };
        // Only light or dark is a choice; no key (or an old "system") follows the phone.
        const stored = () => {
          const t = read();
          return t === "light" || t === "dark" ? t : null;
        };
        const apply = () => {
          root.setAttribute("data-theme", stored() || (dark.matches ? "dark" : "light"));
        };
        apply();
        // Another tab's tap (or a cleared storage) wins over this page's.
        window.addEventListener("storage", (e) => {
          if (e.key !== null && e.key !== "phx:theme") return;
          tapped = null;
          apply();
        });
        dark.addEventListener("change", apply);
        // A plain click listener, so the toggle works on pages without a LiveView socket.
        document.addEventListener("click", (e) => {
          if (!e.target.closest("#theme-toggle")) return;
          tapped = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("phx:theme", tapped);
          } catch {}
          apply();
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
