<Layouts.app flash={@flash} talk_link main_class="px-4 pb-8">
  <div class="home home-tide">
    <section id="home-hero" class="home-hero" aria-labelledby="home-heading">
      <p id="home-eyebrow" class="home-eyebrow">A Pokémon Emerald companion</p>
      <h1 id="home-heading" class="home-heading">Ask out loud. No spoilers.</h1>
      <p class="home-lead">
        Hold the button, ask about your game, and hear a short answer based on your badges and Team.
      </p>
      <a id="talk-link" href={~p"/talk"} class="home-cta">Talk to Maya</a>
      <p id="mic-note" class="home-note">
        The mic is on while you hold, and off a few seconds after.
      </p>
    </section>

    <section id="real-turn" class="home-section" aria-label="A real turn, Route 104">
      <p class="home-eyebrow" aria-hidden="true">A real turn, Route 104</p>
      <p id="real-turn-question" class="real-turn-question">{real_turn().question}</p>
      <p id="real-turn-answer" class="real-turn-answer">{real_turn().answer}</p>
      <p id="real-turn-latency" class="home-note">{real_turn_caption(real_turn())}</p>
    </section>

    <section id="meet-maya" class="home-section" aria-labelledby="meet-maya-heading">
      <h2 id="meet-maya-heading">Meet Maya. She has opinions.</h2>
      <div class="meet-intro">
        <div id="pokeball" class="pokeball pokeball-emerald" aria-hidden="true">
          <div class="pokeball-button"></div>
        </div>
        <p id="home-catchphrase" class="bubble">
          So I hear you like Mudkip. Good. Correct choice.
        </p>
      </div>
      <p id="home-tagline" class="home-tagline">Maps, Answers, Yaps, Advice.</p>

      <h3 class="home-sub">Her Dials</h3>
      <ul id="dials" class="dials">
        <li :for={{name, value, locked?} <- dials()} class="dial">
          <span class="dial-name">{name}</span>
          <span class="dial-value">{value}{if locked?, do: ", locked"}</span>
          <span class="dial-bar" style={"--dial: #{value}%"} aria-hidden="true"></span>
        </li>
      </ul>

      <h3 class="home-sub">Things she says</h3>
      <ul id="sayings" class="sayings">
        <li class="saying bubble">Mudkip would approve.</li>
        <li class="saying bubble">Further ahead, no spoilers.</li>
        <li class="saying bubble">Mudkip is a pure Water type, and Maya is not biased at all.</li>
      </ul>
    </section>

    <section id="voice-loop" class="home-section" aria-labelledby="voice-loop-heading">
      <h2 id="voice-loop-heading">How a turn works</h2>
      <ol class="loop">
        <li>
          <span class="loop-step">Hold</span>
          <span class="loop-text">Press and hold the Talk button and ask out loud.</span>
        </li>
        <li>
          <span class="loop-step">Transcribe</span>
          <span class="loop-text">Mistral Voxtral turns your Question into text.</span>
        </li>
        <li>
          <span class="loop-step">Agent with tools</span>
          <span class="loop-text">
            Maya looks up facts in her own game data, never past your Next gym.
          </span>
        </li>
        <li>
          <span class="loop-step">Speak</span>
          <span class="loop-text">She answers out loud in two or three sentences.</span>
        </li>
      </ol>
      <p id="latency-pending" class="home-note">
        Latency per stage: pending the phone check. Measured numbers go here once they are recorded on a real phone.
      </p>
    </section>

    <section id="spoiler-promise" class="promise-band" aria-labelledby="spoiler-promise-heading">
      <h2 id="spoiler-promise-heading">Further ahead, no spoilers.</h2>
      <p id="promise-ci-gate">
        A CI spoiler gate checks every change: 20 spoiler Questions run on every change, and the build fails if anything past the Spoiler horizon reaches the model. A nightly probe asks the live Maya the same Questions.
      </p>
    </section>

    <Layouts.site_footer />
  </div>
</Layouts.app>
